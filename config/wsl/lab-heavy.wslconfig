[wsl2]
memory=28GB
processors=12
swap=12GB
swapFile=E:\\WSL\\swap\\wsl-swap.vhdx
networkingMode=mirrored
dnsTunneling=true
firewall=true
autoProxy=true
nestedVirtualization=false
maxCrashDumpCount=3

[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
bestEffortDnsParsing=true
hostAddressLoopback=true
