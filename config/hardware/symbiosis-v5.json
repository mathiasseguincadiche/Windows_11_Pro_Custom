{
  "version": "V5",
  "reviewedAt": "2026-08-12",
  "policy": "observe-verify-no-automatic-overclocking",
  "drivers": {
    "amdChipset": {
      "displayNameRegex": "AMD Chipset Software",
      "minimumApprovedVersion": "8.05.04.516",
      "source": "https://www.amd.com/en/support/downloads/drivers.html/chipsets/am5/b850.html",
      "autoUpdate": false
    },
    "intelArc": {
      "deviceNameRegex": "Arc.*B580",
      "minimumApprovedVersion": "32.0.101.8864",
      "source": "https://www.intel.com/content/www/us/en/download/785597/intel-arc-graphics-windows.html",
      "requireResizableBarManualProof": true,
      "autoUpdate": false
    }
  },
  "bios": {
    "reviewMode": "manual-stable-only",
    "autoFlash": false
  },
  "storage": {
    "modelRegex": "T705|CT[0-9]+T705",
    "minimumCount": 2,
    "requireNvme": true,
    "requireHealthy": true,
    "temperatureWarningC": 65,
    "temperatureCriticalC": 70,
    "failOnCriticalTemperature": true,
    "autoFirmwareUpdate": false
  },
  "network": {
    "lanDeviceRegex": "Realtek.*8126|8126.*Realtek|Realtek.*5G",
    "wifiDeviceRegex": "Wi-Fi 7|FastConnect 7800|NCM865",
    "requireLanDevice": true,
    "requireWifiDevice": true,
    "expectedLanMaximumLinkBps": 5000000000,
    "mutateOffloads": false
  },
  "security": {
    "auditVbs": true,
    "auditHvci": true,
    "autoEnableHvci": false,
    "driverCompatibilityFirst": true
  },
  "power": {
    "policy": "balanced",
    "allowUltimatePerformance": false,
    "allowCoreParkingTweaks": false,
    "allowTimerTweaks": false
  },
  "automaticTuningForbidden": [
    "pbo-advanced",
    "curve-optimizer",
    "manual-ddr5-timings",
    "gpu-overclock-or-undervolt",
    "hpet-or-bcd-timer-tweaks",
    "network-offload-disable",
    "pagefile-disable",
    "memory-compression-disable",
    "bios-flash",
    "ssd-firmware-flash"
  ]
}
