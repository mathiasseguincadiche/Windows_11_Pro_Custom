      "id": "User.WpcNewTab",
      "name": "Nouvel onglet PowerShell DevOps",
      "command": {
        "action": "newTab",
        "profile": "PowerShell 7 - DevOps"
      },
      "keys": "ctrl+t"
    },
    {
      "id": "User.WpcPowerShellDevOps",
      "name": "PowerShell 7 - DevOps",
      "command": {
        "action": "newTab",
        "profile": "PowerShell 7 - DevOps"
      },
      "keys": "ctrl+shift+1"
    },
    {
      "id": "User.WpcUbuntuDevOps",
      "name": "Ubuntu - DevOps",
      "command": {
        "action": "newTab",
        "profile": "Ubuntu - DevOps"
      },
      "keys": "ctrl+shift+2"
    },
    {
      "id": "User.WpcPowerShellAdmin",
      "name": "PowerShell 7 - DevOps (Admin)",
      "command": {
        "action": "newTab",
        "profile": "PowerShell 7 - DevOps (Admin)",
        "elevate": true
      },
      "keys": "ctrl+shift+3"
    },
    {
      "id": "User.WpcRenameTab",
      "name": "Renommer l'onglet courant",
      "command": "openTabRenamer",
