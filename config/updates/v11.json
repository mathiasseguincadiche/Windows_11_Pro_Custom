{
  "schemaVersion": "1.0",
  "windowsUpdate": {
    "includeDriversByDefault": false,
    "includeOptionalByDefault": false,
    "forceReboot": false,
    "provider": "Windows Update Agent COM"
  },
  "winget": {
    "respectPins": true,
    "includeUnknownByDefault": false,
    "force": false
  },
  "wsl": {
    "distributionContract": "config/wsl/runtime-contract.json",
    "updateRuntimeOnApply": true,
    "allowDistributionReleaseUpgrade": false
  },
  "ubuntu": {
    "refreshMetadataOnAudit": true,
    "upgradeStrategy": "upgrade-with-new-pkgs",
    "autoremove": false,
    "distUpgrade": false
  },
  "vscode": {
    "updateExtensionsOnApply": true,
    "preserveManagedExtensionSet": true
  },
  "devops": {
    "versionsFile": "config/devops/tool-versions.env",
    "internetLatestIsTruth": false,
    "reconcileOnlyPinnedTargets": true
  },
  "logs": {
    "root": "logs/updates",
    "orchestrator": "logs/updates/system-update.log",
    "summary": "reports/updates/latest-run.json"
  }
}
